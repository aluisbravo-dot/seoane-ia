# Copia este archivo como ".env" (sin .example) y pega SOLO las claves que tengas.
# Con una sola clave ya funciona. Si pones varias, prueba en orden y salta a la siguiente si una falla.

# Claude (Anthropic) - https://console.anthropic.com
ANTHROPIC_API_KEY=pega_aqui_tu_clave
ANTHROPIC_MODEL=claude-sonnet-5-5

# ChatGPT (OpenAI) - https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (Google) - https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# DeepSeek - https://platform.deepseek.com
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Otro (OpenRouter, Groq u Ollama en tu PC). Ejemplo Ollama (gratis, local):
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_MODEL=llama3.2
# CUSTOM_API_KEY=
# CUSTOM_NAME=Ollama

# Orden de prueba (opcional)
# PROVIDER_ORDER=anthropic,openai,gemini,deepseek,custom
# Si la web está en otro sitio (GitHub Pages), pon su dirección para que solo ella use tu IA:
# ALLOWED_ORIGIN=https://TU-USUARIO.github.io
PORT=3000

# Copia este archivo como ".env" y configura la clave SOLO en el servidor.
# Nunca pongas una clave real en archivos públicos, HTML o JavaScript.
GROQ_API_KEY=pega_aqui_tu_clave
# Modelo recomendado por Groq; cámbialo si no está habilitado en tu cuenta.
GROQ_MODEL=openai/gpt-oss-120b

# Groq se usa por defecto. Puedes indicar proveedores alternativos configurados
# en el servidor (anthropic,openai,gemini,deepseek,custom), separados por comas.
# PROVIDER_ORDER=groq
# Si la web está en otro sitio (GitHub Pages), pon su dirección para que solo ella use tu IA:
# ALLOWED_ORIGIN=https://TU-USUARIO.github.io
PORT=3000
